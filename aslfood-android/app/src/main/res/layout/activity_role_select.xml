<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_body"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="48dp">

        <!-- Logo + sarlavha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍔"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/primary_brand"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <!-- ═══ Rol kartalari ════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <!-- Mijoz kartasi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/role_customer"
                        android:textColor="@color/text_dark"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/role_customer_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Oshxona kartasi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKitchen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🍳"
                        android:textSize="48sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/role_kitchen"
                        android:textColor="@color/text_dark"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/role_kitchen_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ═══ PIN panel (faqat oshxona tanlanganda ko'rinadi) ═══════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pin_title"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- PIN nuqtalar ko'rinishi -->
                <LinearLayout
                    android:id="@+id/layoutPinDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <View android:id="@+id/dot1"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/pin_dot_empty" />
                    <View android:id="@+id/dot2"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/pin_dot_empty" />
                    <View android:id="@+id/dot3"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/pin_dot_empty" />
                    <View android:id="@+id/dot4"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/pin_dot_empty" />
                </LinearLayout>

                <!-- Xato xabar -->
                <TextView
                    android:id="@+id/tvPinError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pin_wrong"
                    android:textColor="@color/rose_500"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- PIN klaviatura -->
                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:columnCount="3"
                    app:rowCount="4">

                    <!-- 1..9 -->
                    <Button android:id="@+id/btn1" style="@style/PinButton" android:text="1" />
                    <Button android:id="@+id/btn2" style="@style/PinButton" android:text="2" />
                    <Button android:id="@+id/btn3" style="@style/PinButton" android:text="3" />
                    <Button android:id="@+id/btn4" style="@style/PinButton" android:text="4" />
                    <Button android:id="@+id/btn5" style="@style/PinButton" android:text="5" />
                    <Button android:id="@+id/btn6" style="@style/PinButton" android:text="6" />
                    <Button android:id="@+id/btn7" style="@style/PinButton" android:text="7" />
                    <Button android:id="@+id/btn8" style="@style/PinButton" android:text="8" />
                    <Button android:id="@+id/btn9" style="@style/PinButton" android:text="9" />

                    <!-- O'chirish (backspace) -->
                    <Button android:id="@+id/btnPinClear"
                        style="@style/PinButton"
                        android:text="⌫"
                        android:textSize="20sp" />
                    <Button android:id="@+id/btn0" style="@style/PinButton" android:text="0" />

                    <!-- Bo'sh joy (grid balancing) -->
                    <Space
                        android:layout_width="72dp"
                        android:layout_height="72dp" />

                </androidx.gridlayout.widget.GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Qurilma rejimini o'zgartirish tugmasi (faqat rol o'rnatilgan bo'lsa ko'rinadi) -->
        <TextView
            android:id="@+id/tvChangeRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/change_role"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
