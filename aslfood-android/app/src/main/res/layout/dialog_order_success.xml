<?xml version="1.0" encoding="utf-8"?>
<!--
    Dialog o'zi transparent — bg_dialog_rounded (24dp radius) fon beradi.
    Window kengligi CartFragment'da: dialog.window?.setLayout(
        (resources.displayMetrics.widthPixels * 0.88).toInt(), WRAP_CONTENT
    ) bilan cheklanadi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <!-- Confetti emoji -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉"
        android:textSize="60sp" />

    <!-- Sarlavha -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/order_success_title"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Buyurtma kodi pill -->
    <TextView
        android:id="@+id/tvSuccessOrderCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/badge_bg"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:minWidth="120dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <!-- Tavsif -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="Kuzatish sahifasida buyurtmangiz holatini real vaqtda kuzatishingiz mumkin."
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Ajratuvchi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="@color/bg_surface" />

    <!-- OK tugmasi -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSuccessOk"
        style="@style/AslFood.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/ok"
        android:textSize="15sp"
        app:cornerRadius="14dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
