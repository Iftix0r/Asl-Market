<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ Asosiy tema ══════════════════════════════════════════════════════ -->
    <style name="Theme.AslFood" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/amber_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/amber_100</item>
        <item name="colorOnPrimaryContainer">@color/amber_700</item>
        <item name="colorSecondary">@color/emerald_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <!--
            "colorBackground" (namespace-siz) Material3 da yo'q —
            android:colorBackground va android:windowBackground ishlatiladi.
        -->
        <item name="android:colorBackground">@color/bg_body</item>
        <item name="android:windowBackground">@color/bg_body</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- ═══ Splash tema ══════════════════════════════════════════════════════ -->
    <style name="Theme.AslFood.Splash" parent="Theme.AslFood">
        <item name="android:statusBarColor">@color/amber_600</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/amber_600</item>
    </style>

    <!-- ═══ Widget stillari ══════════════════════════════════════════════════ -->

    <style name="AslFood.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <style name="AslFood.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/amber_600</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="AslFood.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/amber_600</item>
        <item name="android:textColor">@color/amber_600</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!--
        Status badge stillari.
        MUHIM: dot-notation da Android "AslFood.StatusBadge" degan ota stil qidiradi.
        Yechim: har bir stilga parent="android:Widget.TextView" berib, mustaqil qilish.
        Yoki dot-notation o'rniga _ ishlatish.
        Bu yerda parent ko'rsatildi — xato yo'qoladi.
    -->

    <style name="AslFood.StatusBadge" parent="android:Widget.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="AslFood.StatusBadge.New">
        <item name="android:background">@drawable/status_badge_new</item>
    </style>

    <style name="AslFood.StatusBadge.Preparing">
        <item name="android:background">@drawable/status_badge_preparing</item>
    </style>

    <style name="AslFood.StatusBadge.Delivering">
        <item name="android:background">@drawable/status_badge_delivering</item>
    </style>

    <style name="AslFood.StatusBadge.Completed">
        <item name="android:background">@drawable/status_badge_completed</item>
    </style>

</resources>
